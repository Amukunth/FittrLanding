generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One waitlist signup. A row is only ever written for someone who confirmed
/// they are 18 or older — the age gate ends the flow client-side before any
/// data is sent, so under-18 visitors leave no record at all.
model Signup {
  id String @id @default(cuid())

  email String  @unique
  name  String?

  /// Always true for persisted rows. Kept explicit because the eligibility
  /// query that derives waitlist position states its own conditions.
  ageConfirmed Boolean @default(true) @map("age_confirmed")

  state String?

  /// SQLite has no array type. Stored as a comma-separated list of chip
  /// values, read and written only through lib/interests.ts.
  challengeInterests String @default("") @map("challenge_interests")

  referralSource String?   @map("referral_source")
  termsAgreedAt  DateTime? @map("terms_agreed_at")

  referralCode   String  @unique @map("unique_referral_code")
  referredByCode String? @map("referred_by_code")

  /// Null for restricted-state signups: they hold no place in the line.
  waitlistPosition Int? @map("waitlist_position")

  /// True only for eligible signups inside the first BONUS_CAP positions.
  bonusEligible Boolean @default(false) @map("bonus_eligible")

  /// "eligible"         — in the line, with or without a bonus spot.
  /// "restricted_state" — notify-me list only: no position, no bonus.
  status String @default("eligible")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([referredByCode])
  @@index([status])
  @@map("signups")
}
